page {
  background: #F4F7FB;
}

.detail-page {
  padding: 24rpx 32rpx 180rpx;
}

.detail-hero {
  padding: 42rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #EEF2FF 100%);
  border: 2rpx solid #E8EDF5;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.04);
}

.amount {
  font-size: 56rpx;
  font-weight: 900;
  color: #4F46E5;
  line-height: 1.1;
}

.title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #1F2937;
  line-height: 1.45;
  overflow-wrap: break-word;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #4F46E5;
  font-size: 22rpx;
  font-weight: 800;
  border: 2rpx solid #E0E7FF;
}

.section-card {
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8EDF5;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 900;
}

.info-list {
  margin-top: 18rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.label {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 800;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1F2937;
  font-weight: 700;
  overflow-wrap: break-word;
}

.timeline {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
  position: relative;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #4F46E5;
  box-shadow: 0 0 0 8rpx #EEF2FF;
  flex-shrink: 0;
}

.timeline-main {
  flex: 1;
  min-width: 0;
  padding-bottom: 2rpx;
}

.timeline-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #1F2937;
}

.timeline-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.5;
}

.action-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #F8FAFC;
}

.action-label {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 900;
}

.action-value {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 700;
  text-align: right;
}

.action-item-danger {
  background: #FEF2F2;
}

.action-item-danger .action-label,
.action-item-danger .action-value {
  color: #D92D20;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 32rpx calc(env(safe-area-inset-bottom) + 22rpx);
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #EEF2F7;
  display: flex;
}

.secondary-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 28rpx;
  background: #4F46E5;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(79, 70, 229, 0.22);
}
