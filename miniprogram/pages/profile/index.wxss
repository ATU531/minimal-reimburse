page {
  background: #F4F7FB;
}

.profile-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4338CA 0%, #1E1B4B 100%);
  color: #FFFFFF;
  box-shadow: 0 30rpx 64rpx rgba(79, 70, 229, 0.18);
}

.profile-glow {
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  filter: blur(18rpx);
}

.profile-main-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(255, 255, 255, 0.1);
}

.profile-avatar-image {
  display: block;
  width: 220rpx;
  height: 220rpx;
  transform: translate(-58rpx, -44rpx);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.profile-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-stat-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 38rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
}

.profile-stat {
  min-width: 0;
  padding: 16rpx 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  text-align: center;
}

.profile-stat-value {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-word;
}

.profile-stat-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 1.35;
  word-break: break-word;
}

.menu-group {
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8EDF5;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.04);
}

.menu-group-title {
  padding: 22rpx 32rpx;
  border-bottom: 2rpx solid #F1F5F9;
  color: #94A3B8;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
}

.menu-item {
  min-height: 106rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  color: #334155;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
}

.menu-value {
  max-width: 160rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #EEF2FF;
  color: #4F46E5;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-word;
  text-align: center;
}

.menu-arrow {
  flex-shrink: 0;
  color: #CBD5E1;
  font-size: 44rpx;
  line-height: 1;
}

.contact-modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56rpx;
  background: rgba(0, 0, 0, 0.48);
}

.contact-modal-card {
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.18);
}

.contact-modal-title {
  padding: 54rpx 48rpx 22rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.contact-modal-body {
  padding: 12rpx 36rpx 48rpx;
}

.contact-modal-line {
  margin-top: 18rpx;
  color: #8A8F98;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
  white-space: nowrap;
}

.contact-modal-line:first-child {
  margin-top: 0;
}

.contact-modal-confirm {
  min-height: 94rpx;
  border-top: 2rpx solid #EEF2F7;
  color: #53658A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 94rpx;
  text-align: center;
}
