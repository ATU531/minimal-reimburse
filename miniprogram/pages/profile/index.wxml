<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-glow"></view>
    <view class="profile-main-row">
      <view class="profile-avatar">
        <image class="profile-avatar-image" src="/images/票易理头像.png" mode="aspectFill"></image>
      </view>
      <view class="profile-main">
        <view class="profile-name">票易理</view>
        <view class="profile-subtitle">发票收集与原票 PDF 归档</view>
      </view>
    </view>

    <view class="profile-stat-grid">
      <view class="profile-stat" wx:for="{{profileStats}}" wx:key="label" wx:for-item="item">
        <view class="profile-stat-value">{{item.value}}</view>
        <view class="profile-stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="menu-group" wx:for="{{menuGroups}}" wx:key="id" wx:for-item="group">
    <view class="menu-group-title">{{group.title}}</view>
    <view
      class="menu-item"
      wx:for="{{group.items}}"
      wx:key="label"
      wx:for-item="entry"
      data-label="{{entry.label}}"
      data-action="{{entry.action}}"
      data-page="{{entry.page}}"
      bindtap="handleTap"
    >
      <image class="menu-icon" src="{{entry.icon}}" mode="aspectFit"></image>
      <view class="menu-main">
        <view class="menu-label">{{entry.label}}</view>
      </view>
      <view class="menu-value" wx:if="{{entry.value}}">{{entry.value}}</view>
      <view class="menu-arrow" wx:if="{{entry.page}}">›</view>
    </view>
  </view>

  <view wx:if="{{showContactModal}}" class="contact-modal-mask" bindtap="hideContactModal">
    <view class="contact-modal-card" catchtap="noop">
      <view class="contact-modal-title">联系我们</view>
      <view class="contact-modal-body">
        <view class="contact-modal-line" wx:for="{{contactRows}}" wx:key="label" wx:for-item="item">{{item.label}}：{{item.value}}</view>
      </view>
      <view class="contact-modal-confirm" bindtap="hideContactModal">确定</view>
    </view>
  </view>
</view>
