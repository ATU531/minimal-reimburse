page {
  background: #f4f7fb;
}

.container {
  padding: 32rpx 24rpx 44rpx;
  font-family: PingFang SC;
  color: #182230;
}

.section {
  margin-top: 28rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.entry-card {
  width: calc(50% - 8rpx);
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 24, 40, 0.04);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #4f6ef7 0%, #89a4ff 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #101828;
}

.feature-list,
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-card,
.reminder-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.05);
}

.feature-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.feature-main {
  flex: 1;
}

.feature-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.feature-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 20rpx;
}

.feature-arrow {
  color: #98a2b3;
  font-size: 30rpx;
}

.reminder-label {
  font-size: 24rpx;
  color: #667085;
}

.reminder-value {
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 600;
  color: #101828;
}

.page-spacer {
  height: 40rpx;
}
