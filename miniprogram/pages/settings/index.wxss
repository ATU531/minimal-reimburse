page {
  background: #F4F7FB;
}

.page {
  padding: 32rpx;
  font-family: Inter, "Noto Sans SC", "PingFang SC", sans-serif;
}

.hero-card,
.group-card,
.tips-card {
  padding: 34rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8EDF5;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.04);
}

.hero-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #EEF2FF 100%);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #1F2937;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748B;
}

.group-card,
.tips-card {
  margin-top: 24rpx;
}

.group-title,
.tips-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #1F2937;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #334155;
}

.setting-state {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4F46E5;
  font-weight: 800;
}

.tips-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748B;
}
